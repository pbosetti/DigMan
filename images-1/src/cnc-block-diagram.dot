// CNC machine tool: functional block diagram
digraph cnc {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica", nodesep=0.16, ranksep=0.5, splines=ortho]
  node  [shape=box, style="rounded,filled", fillcolor="#f9f9ff", color="#666666",
         fontname="Helvetica", fontsize=14, width=2.4, height=0.45]
  edge  [color="#333333", arrowsize=0.7, dir=both, arrowtail=none]

  pp   [label="Part-\nprogram", fillcolor="#ffffff", width=1.1, height=4.2]
  cnc  [label="CNC", fillcolor="#f3eaea", color="#880000", fontcolor="#880000", width=0.9, height=4.2, fontsize=18]
  drv  [label="Drivers", fillcolor="#e8e8f8", color="#000088", fontcolor="#000088", width=1.1, height=1.55]
  plc  [label="PLC", fillcolor="#e8f4e8", color="#008800", fontcolor="#008800", width=1.1, height=2.5]

  ways [label="Ways"]
  enc  [label="Encoders"]
  mot  [label="Motors"]
  sup  [label="Supplementary axes"]
  pump [label="Pumps"]
  saf  [label="Safety systems"]
  cond [label="Conditioners, thermostats"]
  more [label="…", style="rounded,dashed"]

  pp -> cnc
  cnc -> drv
  cnc -> plc [arrowtail=normal]
  drv -> mot
  drv -> enc [dir=back, arrowtail=normal, arrowhead=none]
  drv -> ways [arrowhead=none]
  plc -> sup
  plc -> pump
  plc -> saf [arrowtail=normal]
  plc -> cond [arrowtail=normal]
  plc -> more
  {rank=same; drv; plc}
  edge [style=invis]
  ways -> enc -> mot -> sup -> pump -> saf -> cond -> more
  {rank=same; ways; enc; mot; sup; pump; saf; cond; more}
}
